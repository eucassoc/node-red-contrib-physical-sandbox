{
  "name": "node-red-contrib-physical-sandbox",
  "version": "0.2.0",
  "description": "Physical Sandbox for Node-RED: a sidebar pane that shows robots on a real site, moved by MQTT messages and records",
  "license": "Apache-2.0",
  "author": "Atsushi Kojo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eucassoc/node-red-contrib-physical-sandbox.git"
  },
  "keywords": [
    "node-red"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES",
    "README.md",
    "README.ja.md"
  ],
  "bin": {
    "ps-nodered-mcp": "dist/bin/ps-nodered-mcp.js"
  },
  "node-red": {
    "version": ">=4.1.0",
    "plugins": {
      "physical-sandbox": "dist/plugin/index.js"
    },
    "nodes": {
      "ps-in": "dist/nodes/ps-in.js",
      "ps-play": "dist/nodes/ps-play.js"
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build && npm run typecheck",
    "test": "PS_STRICT_WORDS=1 node --import tsx --test \"tests/**/*.test.{ts,js}\"",
    "pretest:nr5": "npm run build",
    "test:nr5": "PS_STRICT_WORDS=1 PS_NODE_RED=node-red-5 node --import tsx --test tests/smoke.test.ts tests/smoke-adminauth.test.ts",
    "start:dev": "npm run build && node tools/run-node-red.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.5",
    "@types/node-red": "1.3.5",
    "aedes": "1.2.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "node-red": "4.1.17",
    "node-red-5": "npm:node-red@5.0.9",
    "node-red-node-test-helper": "0.3.6",
    "three": "0.180.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
